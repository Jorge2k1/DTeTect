{
  "name": "evidence-aggregation-system",
  "private": true,
  "version": "0.1.0",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "test": "npm run test --workspaces --if-present",
    "build:extension": "npm run build --workspace=@eas/extension",
    "typecheck": "tsc -p packages/core --noEmit && npm run typecheck --workspace=@eas/extension",
    "inspect:image": "node scripts/inspect-image-metadata.mjs"
  }
}
